{
  "opencollection": "1.0.0",
  "info": {
    "name": "Inflection Inference Chat Embeddings API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Embeddings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Embeddings",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/embeddings",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Embeddings endpoint for Inflection hosted models."
        }
      ]
    }
  ],
  "bundled": true
}